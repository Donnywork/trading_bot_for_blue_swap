# Infura Sepolia endpoint: app.infura.io -> your API key -> Sepolia. The URL contains the key,
# so treat it as a secret (the bot redacts it from its logs).
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_API_KEY
# free public fallback (rate limited, not for 24/7): https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=
POOL_ADDRESS=0x6a8BCbC98ff2485582049e67299fb16ad900728B
ROUTER_ADDRESS=0x3bFA4769FB09eefC5a80d6E87c3B9C650f7Ae48E
QUOTER_ADDRESS=0xEd1f6473345F45b75F8179591dd5bA1888cf2FB3
F564_ADDRESS=0xfd840838F598d7abB153a8bc93f4a2FF38D2D5B8
FETH_ADDRESS=0x1967a5A5f12Cbd95f12847067C2c00F044D3EF11
# enrolled wallet: owns the bot contract and can withdraw
OWNER_ADDRESS=
# filled in after `uv run python bot_contract.py deploy`
BOT_CONTRACT_ADDRESS=
DRY_RUN=true
MAX_TRADE_AMOUNT=0.01        # size of one BUY, in f564 (the quote token); a sell closes exactly what the buy delivered. Also the on-chain per-swap cap
# Optional: size each buy by risk instead. A stop loss should cost about this share (%) of the f564 in the vault
# (pool fee and price impact included, worked out on the pool's liquidity layout saved in pool_profile.json,
# scaled by one read of the pool's liquidity when a buy is sized: a bigger buy pays more impact), and a buy is
# never above MAX_TRADE_AMOUNT. 0 = every buy is MAX_TRADE_AMOUNT.
RISK_PER_TRADE_PCT=0

# --- bot loop (main.py) ---
# seconds between price checks
POLL_SECONDS=30
# minimum seconds between a trade and the next BUY (an exit right after a buy is not delayed)
COOLDOWN_SECONDS=300
# skip trading (and warn) when the operator wallet has less ETH than this
MIN_OPERATOR_ETH=0.01
# halt the bot after this many failed trades in a row
MAX_TRADE_FAILURES=3

# --- not here ---
# The strategy, take profit, stop loss, the pattern-guard limits and the strategy's own numbers are changed on the dashboard
# (python dashboard.py) and saved to logs/control.json. DRY_RUN and MAX_TRADE_AMOUNT can only be
# changed in this file, on purpose, and so can RISK_PER_TRADE_PCT (restart the bot and the dashboard after editing it).
