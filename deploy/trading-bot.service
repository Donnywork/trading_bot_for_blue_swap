# systemd unit for Ubuntu 24.04. Replace __USER__ and __PROJECT_DIR__ (see docs/DEPLOY.md, part 4).
[Unit]
Description=Uniswap V3 trading bot (Sepolia testnet)
After=network-online.target
Wants=network-online.target
# give up (and show "failed") if it crashes 5 times within 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__
# runs the venv's Python directly: a restart needs no network and never re-syncs packages
ExecStart=__PROJECT_DIR__/.venv/bin/python main.py
Environment=PYTHONUNBUFFERED=1

# Restart after a crash (non-zero exit) but NOT after a clean stop or a kill-switch halt
# (the bot exits 0 in both cases and writes logs/HALTED)
Restart=on-failure
RestartSec=30

# `systemctl stop` sends SIGTERM; the bot finishes the current tick (a swap can wait up to
# ~2 minutes for its receipt) and then exits. Only after this long does systemd SIGKILL it.
KillSignal=SIGTERM
TimeoutStopSec=240

# light sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
